---
import '../styles/global.css';
const { title = 'Conor Brown | Software Engineer, Architect & Product Builder', description = 'Engineering case studies, software products, and practical writing about building dependable systems.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#10151b" />
<meta name="description" content={description} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<title>{title}</title>
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
</head>
<body>
<a class="skip-link" href="#content">Skip to content</a>
<header class="site-header"><nav class="nav wrap" aria-label="Primary"><a class="brand" href="/">CONOR<span>.</span>BROWN</a><div class="nav-links"><a href="/work">Engineering</a><a href="/projects">Projects</a><a href="/writing">Writing</a><a href="/about">About & Résumé</a></div></nav></header>
<div id="content" class="page-shell"><slot /></div>
<footer class="site-footer wrap"><span>© {new Date().getFullYear()} Conor Brown · Built with Astro</span><div><a href="https://github.com/conorbrown-dev">GitHub ↗</a><a href="/about">Get in touch ↗</a></div></footer>
</body>
</html>