---
import Layout from '../layouts/Layout.astro';
const projects=[
{name:'Pathway',label:'Learning platform',description:'A practical software engineering learning experience combining foundational explanation, progressive depth, exercises and assessments.',url:'https://pathway.orangecastle.net',code:'https://github.com/conorbrown-dev/pathway'},
{name:'Theoria',label:'Music education',description:'Courses for music theory, instrumentation, recording, production, mixing and mastering with an emphasis on practical workflows.',url:'https://theoria.orangecastle.net'},
{name:"Molly's Learning Game",label:'Educational game',description:'A game-based learning project bringing instructional design and interactive software together.',status:'Project details and demo to be added.'},
{name:'Praxis Studio',label:'Mobile application',description:'A mobile product exploring practical workflows and the challenges of delivering a coherent cross-platform experience.',status:'Product walkthrough and architecture details to be added.'}
];
---
<Layout title="Projects | Conor Brown"><main><div class="intro"><p class="eyebrow">Ideas made tangible</p><h1>Products & projects.</h1><p class="lead">Outside of employer work I build learning tools, applications, and experiments that put engineering ideas into practice.</p></div><div class="grid">{projects.map(project=><article class="card"><span class="tag">{project.label}</span><h2>{project.name}</h2><p>{project.description}</p><div class="actions">{project.url&&<a class="button primary" href={project.url}>Explore project ↗</a>}{project.code&&<a class="button" href={project.code}>Source ↗</a>}{project.status&&<span class="muted">{project.status}</span>}</div></article>)}</div></main></Layout>