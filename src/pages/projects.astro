---
import Layout from '../layouts/Layout.astro';
const projects=[
{name:'Pathway',label:'Software engineering education',description:'Instruction-first courses that develop from approachable examples toward deeper architectural and technical concepts.',detail:'/projects/pathway',url:'https://pathway.orangecastle.net'},
{name:'Theoria',label:'Music learning product',description:'Practical curricula for instrumental performance, production, mixing, and mastering, organized around usable workflows.',detail:'/projects/theoria',url:'https://theoria.orangecastle.net'},
{name:"Molly's Learning Arcade",label:'Educational game',description:'A game-based learning application combining interactive software with instruction and practice.',detail:'/projects/mollys-learning-arcade'},
{name:'Praxis Studio',label:'Cross-platform application',description:'A mobile application project exploring product development across web, backend, and mobile experiences.',detail:'/projects/praxis-studio'}
];
---
<Layout title="Projects | Conor Brown"><main><div class="intro"><p class="eyebrow">Independent product engineering</p><h1>Products & projects.</h1><p class="lead">Engineering choices become clearer when a product has real users, real workflows, and real constraints. These walkthroughs explain the products and the decisions worth examining.</p></div><div class="grid">{projects.map(project=><article class="card"><span class="tag">{project.label}</span><h2>{project.name}</h2><p>{project.description}</p><div class="actions"><a class="button primary" href={project.detail}>Read walkthrough →</a>{project.url&&<a class="button" href={project.url}>Visit product ↗</a>}</div></article>)}</div></main></Layout>